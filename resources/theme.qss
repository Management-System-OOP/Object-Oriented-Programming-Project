/**
 * theme.qss
 * Central application stylesheet - Windows 11 Fluent-inspired base theme.
 *
 * Scope of this file (Phase 1 - infrastructure only):
 *   This provides the app-wide DEFAULT look for widgets that currently have
 *   NO inline setStyleSheet() call (all three dialogs, plain QPushButtons,
 *   inputs, etc). It intentionally does NOT try to override the ~40 existing
 *   inline setStyleSheet() calls in MainWindow.cpp (sidebar, page titles,
 *   colored action buttons, table headers) - a widget-level setStyleSheet()
 *   always wins over this application-level sheet for that widget, so
 *   nothing currently on-screen changes shape/color yet. Migrating those
 *   inline blocks to use this file happens component-by-component in
 *   Phase 2/3, per the roadmap.
 *
 * Design tokens (Fluent-ish, kept close to the app's existing brand green
 * so Phase 1 doesn't silently re-brand anything - open to revisiting the
 * accent in Phase 2):
 *
 *   Surface / layer 0 (window bg)      #F3F3F3
 *   Surface / layer 1 (cards, dialogs) #FFFFFF
 *   Border (subtle)                    #E1E1E1
 *   Border (stronger / hover)          #D1D1D1
 *   Text - primary                     #201F1E
 *   Text - secondary                   #605E5C
 *   Text - disabled                    #A19F9D
 *   Accent (brand green)               #00B96B
 *   Accent - hover                     #00A25E
 *   Accent - pressed                   #00874F
 *   Danger (destructive actions)       #E53E3E
 *   Radius - small (inputs, chips)     4px
 *   Radius - medium (buttons)          6px
 *   Radius - large (cards, dialogs)    8px
 *   Spacing unit                       8px  (padding built in multiples of it)
 */

/* ---------------------------------------------------------------------- */
/* Global                                                                 */
/* ---------------------------------------------------------------------- */

* {
    font-family: "Segoe UI", "Segoe UI Variable", sans-serif;
}

QMainWindow,
QDialog {
    background-color: #F3F3F3;
}

QWidget {
    color: #201F1E;
    font-size: 13px;
}

QLabel {
    background: transparent;
}

QToolTip {
    background-color: #201F1E;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ---------------------------------------------------------------------- */
/* Buttons (default/secondary style - dialogs, QDialogButtonBox, any       */
/* QPushButton not given a custom color via the buttonStyle() helper)      */
/* ---------------------------------------------------------------------- */

QPushButton {
    background-color: #FFFFFF;
    color: #201F1E;
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #F5F5F5;
    border-color: #B3B3B3;
}

QPushButton:pressed {
    background-color: #E8E8E8;
}

QPushButton:disabled {
    background-color: #F3F3F3;
    color: #A19F9D;
    border-color: #E1E1E1;
}

/* The primary/default action in a dialog (e.g. OK, Save, Apply Filter)
   gets the accent treatment so there's always one clear primary action. */
QPushButton:default {
    background-color: #00B96B;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #00A25E;
}

QPushButton:default:pressed {
    background-color: #00874F;
}

QDialogButtonBox QPushButton {
    min-width: 88px;
}

/* ---------------------------------------------------------------------- */
/* Inputs                                                                  */
/* ---------------------------------------------------------------------- */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #00B96B;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
    border-color: #B3B3B3;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1.5px solid #00B96B;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled {
    background-color: #F3F3F3;
    color: #A19F9D;
    border-color: #E1E1E1;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    width: 18px;
}

/* ---------------------------------------------------------------------- */
/* Checkboxes                                                              */
/* ---------------------------------------------------------------------- */

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #B3B3B3;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #00B96B;
}

QCheckBox::indicator:checked {
    background-color: #00B96B;
    border-color: #00B96B;
}

/* ---------------------------------------------------------------------- */
/* Grouping containers                                                     */
/* ---------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #E1E1E1;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #605E5C;
}

QTabWidget::pane {
    border: 1px solid #E1E1E1;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #605E5C;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #201F1E;
    font-weight: 600;
    border-bottom: 2px solid #00B96B;
}

QTabBar::tab:hover:!selected {
    color: #201F1E;
}

/* ---------------------------------------------------------------------- */
/* Tables / headers (fallback default - pages with their own inline table  */
/* stylesheet are unaffected; this covers anything not yet migrated)       */
/* ---------------------------------------------------------------------- */

QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FAFAFA;
    gridline-color: #E1E1E1;
    border: 1px solid #E1E1E1;
    border-radius: 8px;
    selection-background-color: #E6F7EF;
    selection-color: #201F1E;
}

QHeaderView::section {
    background-color: #F3F3F3;
    color: #605E5C;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #E1E1E1;
    font-weight: 600;
}

/* ---------------------------------------------------------------------- */
/* Lists (fallback default - the sidebar keeps its own inline dark theme)  */
/* ---------------------------------------------------------------------- */

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E1E1E1;
    border-radius: 8px;
}

/* ---------------------------------------------------------------------- */
/* Scrollbars - thin, flat, Fluent-style                                  */
/* ---------------------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #C7C7C7;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #A6A6A6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #C7C7C7;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #A6A6A6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------------------------------------------------------------- */
/* Message boxes                                                           */
/* ---------------------------------------------------------------------- */

QMessageBox {
    background-color: #FFFFFF;
}
